{
  "name": "paladares-da-mantiqueira",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs && node scripts/gen-landings.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "gen:cardapios": "node scripts/gen-experiencias.mjs",
    "gen:imagens-responsivas": "node scripts/gerar-imagens-responsivas.mjs",
    "prebuild": "node scripts/gen-experiencias.mjs && node scripts/gerar-imagens-responsivas.mjs",
    "lint": "tsc --noEmit",
    "otimizar:imagens": "node scripts/otimizar-imagens.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
